{
  "name": "pixiv-toolkits",
  "version": "6.4.6",
  "description": "A web extension for adding features on Pixiv and more",
  "author": "leoding86 <leoding86@msn.com>",
  "private": false,
  "scripts": {
    "preinstall": "node scripts/only-pnpm.js",
    "dev": "node scripts/build.mjs --watch",
    "dev:firefox": "node scripts/build.mjs --platform=firefox --watch",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --platform=firefox",
    "release:firefox": "node scripts/release-firefox.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "node --test --test-reporter=spec \"e2e-firefox/*.test.mjs\""
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@mdi/font": "^7.4.47",
    "dexie": "^4.4.7",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "moment": "^2.31.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue-virtual-scroller": "^3.0.5",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@mdn/browser-compat-data": "^8.1.9",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.14.0",
    "eslint-plugin-compat": "^7.0.2",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.31",
    "sass": "^1.105.2",
    "semver": "^7.8.5",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=11.0.0 <13.0.0",
    "npm": "please-use-pnpm"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 128"
  ],
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
