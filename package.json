{
  "name": "pixiv-toolkits",
  "version": "6.4.6",
  "description": "A web extension for adding features on Pixiv and more",
  "author": "leoding86 <leoding86@msn.com>",
  "private": false,
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "dev": "cross-env PLATFORM_ENV=chrome webpack --watch --progress --config webpack.config.js",
    "dev:firefox": "cross-env PLATFORM_ENV=firefox webpack --watch --progress --config webpack.config.js --env platform=firefox",
    "dev:cs": "webpack --watch --progress --config config/webpack.content-scripts.config.js",
    "dev:op": "webpack --watch --progress --config config/webpack.options-page.config.js",
    "dev:bg": "webpack --watch --progress --config config/webpack.background.config.js",
    "build": "cross-env NODE_ENV=production PLATFORM_ENV=chrome webpack --config webpack.config.js",
    "build:firefox": "cross-env NODE_ENV=production PLATFORM_ENV=firefox webpack --config webpack.config.js --env platform=firefox",
    "release:firefox": "node scripts/release-firefox.js",
    "test": "cross-env NODE_ENV=test jest --config jest.config.js"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@mdi/font": "^7.4.47",
    "dexie": "^4.4.7",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "moment": "^2.31.0",
    "pako": "^1.0.11",
    "pouchdb": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "upng-js": "^2.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue-virtual-scroller": "^3.0.5",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/runtime": "^8.0.7",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.5",
    "fs-extra": "^11.4.1",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.31",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.0",
    "postcss-url": "^10.1.3",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "vue-loader": "^17.4.2",
    "web-ext": "^10.8.0",
    "webpack": "^5.112.0",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=22.13.0 <27.0.0",
    "pnpm": ">=11.0.0 <13.0.0"
  },
  "browserslist": [
    "chrome >= 88",
    "firefox >= 109"
  ],
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
