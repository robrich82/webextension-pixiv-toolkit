{
  "name": "pixiv-toolkits",
  "version": "6.4.6",
  "description": "A web extension for adding features on Pixiv and more",
  "author": "leoding86 <leoding86@msn.com>",
  "private": false,
  "scripts": {
    "preinstall": "node scripts/only-pnpm.js",
    "dev": "cross-env PLATFORM_ENV=chrome webpack --watch --progress --config webpack.config.js",
    "dev:firefox": "cross-env PLATFORM_ENV=firefox webpack --watch --progress --config webpack.config.js --env platform=firefox",
    "dev:cs": "webpack --watch --progress --config config/webpack.content-scripts.config.js",
    "dev:op": "webpack --watch --progress --config config/webpack.options-page.config.js",
    "dev:bg": "webpack --watch --progress --config config/webpack.background.config.js",
    "build": "cross-env NODE_ENV=production PLATFORM_ENV=chrome webpack --config webpack.config.js",
    "build:firefox": "cross-env NODE_ENV=production PLATFORM_ENV=firefox webpack --config webpack.config.js --env platform=firefox",
    "build:vite": "node scripts/build.mjs",
    "build:vite:firefox": "node scripts/build.mjs --platform=firefox",
    "release:firefox": "node scripts/release-firefox.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "node --test --test-reporter=spec \"e2e-firefox/*.test.mjs\""
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@mdi/font": "^7.4.47",
    "dexie": "^4.4.7",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "moment": "^2.31.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue-virtual-scroller": "^3.0.5",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/plugin-transform-class-properties": "^8.0.0",
    "@babel/plugin-transform-runtime": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/runtime": "^8.0.7",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.5",
    "fake-indexeddb": "^6.2.7",
    "fs-extra": "^11.4.1",
    "html-webpack-plugin": "^5.6.4",
    "jsdom": "^31.0.0",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.31",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.0",
    "postcss-url": "^10.1.3",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "semver": "^7.8.5",
    "style-loader": "^4.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-loader": "^17.4.2",
    "web-ext": "^10.8.0",
    "webpack": "^5.112.0",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=11.0.0 <13.0.0",
    "npm": "please-use-pnpm"
  },
  "browserslist": [
    "chrome >= 88",
    "firefox >= 109"
  ],
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
