{
  "name": "pixiv-toolkits",
  "version": "6.4.2",
  "description": "A web extension for adding features on Pixiv and more",
  "author": "leoding86 <leoding86@msn.com>",
  "private": false,
  "scripts": {
    "dev": "cross-env PLATFORM_ENV=chrome webpack --watch --progress --config webpack.config.js",
    "dev:firefox": "cross-env PLATFORM_ENV=firefox webpack --watch --progress --config webpack.config.js --env platform=firefox",
    "dev:cs": "webpack --watch --progress --config config/webpack.content-scripts.config.js",
    "dev:op": "webpack --watch --progress --config config/webpack.options-page.config.js",
    "dev:bg": "webpack --watch --progress --config config/webpack.background.config.js",
    "build": "cross-env NODE_ENV=production PLATFORM_ENV=chrome webpack --config webpack.config.js",
    "build:firefox": "cross-env NODE_ENV=production PLATFORM_ENV=firefox webpack --config webpack.config.js --env platform=firefox",
    "test": "cross-env NODE_ENV=test jest --config jest.config.json"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.11.0",
    "dexie": "^4.4.4",
    "md5": "^2.3.0",
    "moment": "^2.30.1",
    "pouchdb": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "upng-js": "^2.1.0",
    "vue": "^2.7.16",
    "vue-i18n": "^8.28.2",
    "vue-router": "^3.6.5",
    "vue-virtual-scroller": "^1.1.2",
    "vuedraggable": "^2.24.3",
    "vuetify": "^1.5.24"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/runtime": "^7.28.4",
    "@ffmpeg/ffmpeg": "^0.11.6",
    "@vue/babel-helper-vue-jsx-merge-props": "^1.4.0",
    "@vue/babel-plugin-transform-vue-jsx": "^1.4.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.0.0",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.2",
    "fs-extra": "^11.3.0",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.0.0",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.0",
    "postcss-url": "^10.1.3",
    "sass": "^1.93.0",
    "sass-loader": "^17.0.0",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.101.0",
    "webpack-bundle-analyzer": "^5.0.0",
    "webpack-cli": "^7.0.0",
    "webpack-merge": "^6.0.1",
    "worker-loader": "^3.0.8"
  },
  "comment_overrides": "Both entries keep `npm audit` clean rather than fixing a live exposure; see docs/toolchain.md for why neither advisory is reachable.",
  "overrides": {
    "uuid": "^11.1.1",
    "@vue/component-compiler-utils": {
      "postcss": "^8.5.22"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "browserslist": [
    "chrome >= 88",
    "firefox >= 109"
  ]
}
