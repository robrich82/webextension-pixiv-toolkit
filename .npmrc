# pnpm reads its settings from pnpm-workspace.yaml, including `engineStrict`.
# This file exists for the other direction: someone reaching for `npm install`
# out of habit. npm's `engines` check is advisory by default; strict, it turns
# `engines.npm` (a range no npm satisfies) into a refusal before anything is
# installed. See docs/toolchain.md.
engine-strict=true
