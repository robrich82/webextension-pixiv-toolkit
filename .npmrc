# pnpm reads its settings from pnpm-workspace.yaml, including `engineStrict`.
# This file exists for the other direction: someone reaching for `npm install`
# out of habit. npm's `engines` check is advisory unless strict; strict, it
# enforces the Node ceiling and refuses the `engines.npm` range, which no npm
# satisfies, before anything is installed. See docs/toolchain.md.
engine-strict=true
