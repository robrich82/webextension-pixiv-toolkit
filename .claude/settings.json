{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__[\\w-]*[Mm][Ii][Ss][Ee][\\w-]*__run_task$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-mcp-release.js\"",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/related-tests.js\"",
            "timeout": 180
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/settings-migration-reminder.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
